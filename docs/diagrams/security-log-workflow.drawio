" /></mxCell><mxCell id="d5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#52677e;strokeWidth=2;fontSize=13;fontColor=#23384f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reg" target="assets"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d6" value="โหลดเมื่อวิเคราะห์" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#52677e;strokeWidth=2;fontSize=13;fontColor=#23384f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="assets" target="runtime"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="session" value="Session และ job&lt;br&gt;HMAC-signed HttpOnly cookie&lt;br&gt;ผลผูกกับ session · อายุสูงสุด 60 นาที&lt;br&gt;process restart → ผลเดิมไม่พร้อม" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#e7f1ff;strokeColor=#3575c5;fontColor=#102c50;" vertex="1" parent="1"><mxGeometry x="70" y="610" width="445" height="150" as="geometry" /></mxCell><mxCell id="limits" value="ขอบเขตการรับงาน&lt;br&gt;สูงสุด 10 MiB / 50,000 แถว&lt;br&gt;1 งานวิเคราะห์พร้อมกัน&lt;br&gt;เก็บได้สูงสุด 8 jobs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#fff2dd;strokeColor=#dd983b;fontColor=#563400;" vertex="1" parent="1"><mxGeometry x="580" y="610" width="400" height="150" as="geometry" /></mxCell><mxCell id="free" value="Render Free&lt;br&gt;บริการอาจพักเมื่อไม่มีผู้ใช้&lt;br&gt;ไม่มี persistent disk&lt;br&gt;ข้อมูลผลวิเคราะห์ไม่คงทน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=15;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;fillColor=#f4f6f8;strokeColor=#8b9aa9;fontColor=#273746;" vertex="1" parent="1"><mxGeometry x="1045" y="610